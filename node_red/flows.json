  {
    "id": "debug_telemetry",
    "type": "debug",
    "z": "tab_smart_factory",
    "name": "Raw Telemetry In",
    "active": false,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
