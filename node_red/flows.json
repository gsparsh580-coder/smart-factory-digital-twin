    "y": 140,
    "wires": []
  },
  {
    "id": "fn_process_telemetry",
    "type": "function",
    "z": "tab_smart_factory",
    "name": "Route Gauge Data",
    "func": "var t = msg.payload.telemetry || {};\nvar ai = msg.payload.ai_analytics || {};\nvar oee = msg.payload.oee || {};\n\nvar msgRpm = { payload: t.rpm || 0 };\nvar msgTemp = { payload: t.temperature_c || 0 };\nvar msgVib = { payload: t.vibration_rms || 0 };\nvar msgCurrent = { payload: t.current_a || 0 };\nvar msgHealth = { payload: ai.health_index || 100 };\nvar msgStatus = { payload: msg.payload.status || 'UNKNOWN' };\n\nreturn [msgRpm, msgTemp, msgVib, msgCurrent, msgHealth, msgStatus];",
    "outputs": 6,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 410,
    "y": 240,
    "wires": [
      ["ui_gauge_rpm"],
      ["ui_gauge_temp", "ui_chart_trends"],
      ["ui_gauge_vib", "ui_chart_trends"],
      ["ui_gauge_current"],
      ["ui_gauge_health"],
      ["ui_text_status"]
    ]
  },
  {
    "id": "fn_safety_supervisor",
    "type": "function",
    "z": "tab_smart_factory",
    "name": "Autonomous Safety Supervisor",
    "func": "var t = msg.payload.telemetry || {};\nvar temp = t.temperature_c || 0;\nvar vib = t.vibration_rms || 0;\n\n// Autonomous Safety Threshold Breach\nif (temp > 85.0 || vib > 16.0) {\n    var estopMsg = {\n        topic: \"factory/control/estop\",\n        payload: JSON.stringify({\n            command: \"ESTOP\",\n            reason: \"Autonomous Node-RED Safety Trip: Temp=\" + temp + \"C, Vib=\" + vib + \" mm/s\",\n            timestamp: new Date().toISOString()\n        })\n    };\n    node.warn(\"CRITICAL SAFETY INTERLOCK: \" + estopMsg.payload);\n    return estopMsg;\n}\nreturn null;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 450,
    "y": 380,
    "wires": [
      ["mqtt_out_estop", "ui_toast_alert"]
    ]
  },
  {
    "id": "mqtt_out_estop",
    "type": "mqtt out",
    "z": "tab_smart_factory",
    "name": "MQTT Pub: Auto E-STOP",
    "topic": "factory/control/estop",
    "qos": "1",
    "retain": "false",
    "respTopic": "",
    "contentType": "",
    "userProps": "",
    "correl": "",
    "expiry": "",
    "broker": "mqtt_broker_hivemq",
    "x": 750,
    "y": 360,
    "wires": []
  },
